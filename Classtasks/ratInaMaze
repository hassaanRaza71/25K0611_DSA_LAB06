#include <iostream>
#include <string>

using namespace std;

const int MAX = 10;
string paths[100];
int pathCount = 0;

void solve(int row, int col, int m[MAX][MAX], int n, string move, bool vis[MAX][MAX]) {
    if (row == n - 1 && col == n - 1) {
        paths[pathCount++] = move;
        return;
    }

    char dir[] = {'D', 'L', 'R', 'U'};
    int drow[] = {1, 0, 0, -1};
    int dcol[] = {0, -1, 1, 0};

    for (int i = 0; i < 4; i++) {
        int nextrow = row + drow[i];
        int nextcol = col + dcol[i];

        if (nextrow >= 0 && nextcol >= 0 && nextrow < n && nextcol < n && 
            !vis[nextrow][nextcol] && m[nextrow][nextcol] == 1) {
            
            vis[row][col] = true;
            solve(nextrow, nextcol, m, n, move + dir[i], vis);
            vis[row][col] = false;
        }
    }
}

int main() {
    int n = 4;
    int maze[MAX][MAX] = {
        {1, 0, 0, 0},
        {1, 1, 0, 1},
        {1, 1, 0, 0},
        {0, 1, 1, 1}
    };
    
    bool vis[MAX][MAX] = {false};

    if (maze[0][0] == 1) {
        solve(0, 0, maze, n, "", vis);
    }

    if (pathCount == 0) {
        cout << "-1";
    } else {
        for (int i = 0; i < pathCount; i++) {
            cout << paths[i] << " ";
        }
    }
    cout << endl;

    return 0;
}
